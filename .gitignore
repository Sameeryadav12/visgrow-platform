# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# payload
/media
/public/media

# backups contain personal data — never commit them
/backups

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results
/playwright-report
/.playwright

# Customer files (resumes, feedback). Private — never commit these.
/private-uploads

# Mustafa's original full-size photo folders. Web-sized copies live in public/images/photos.
/public/ADELAIDE OFFICE PHOTOS/
/public/Corporate or Industry Workshops/
/public/Education Workshops/
/public/Self Shots and other/
