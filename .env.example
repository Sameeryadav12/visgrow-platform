# Copy to .env.local and fill in. Never commit .env.local.

DATABASE_URI=postgres://visgrow:visgrow_local_dev@localhost:5433/visgrow
PAYLOAD_SECRET=generate-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "production" ONLY on the real live site. Anything else (staging,
# previews, local) is blocked from Google automatically.
NEXT_PUBLIC_SITE_ENV=development

# First admin account, created automatically on first run if no users exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

RESEND_API_KEY=
EMAIL_FROM=Visgrow <onboarding@resend.dev>
EMAIL_TO=hello@visgrowinternships.com.au

# Required by /api/cron/daily. Generate a long random string.
CRON_SECRET=

# Stripe. Leave blank to disable card payments.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# File storage. Leave blank locally — uploads then write to disk.
# On Vercel: Storage tab -> create a Blob store -> it sets this for you.
# Without it, anything uploaded through the admin panel is lost on the next deploy.
BLOB_READ_WRITE_TOKEN=

# Real Google reviews (optional). Both must be set or the reviews section
# simply doesn't render — there is deliberately no placeholder data.
# Get these from Google Cloud Console (Places API) and the Business Profile.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
